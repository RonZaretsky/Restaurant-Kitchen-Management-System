# Copy this file to backend/.env and fill in a real secret.
# backend/.env is gitignored and must never be committed.
#
# Generate a signing key with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Anything set here is overridden by a real environment variable of the same
# name, so docker-compose and your shell both still win.

# Signs and verifies session JWTs. Leaving this unset falls back to the
# published default in config.yaml, which makes every session forgeable.
# The app logs a warning at startup if that happens.
JWT_SECRET_KEY=

# How long a session lasts. 8 hours matches a work shift (AD-3). There is no
# refresh-token flow: on expiry the user signs in again.
JWT_EXPIRY_HOURS=8

# The exact frontend origin allowed by CORS. Never a wildcard (AD-3).
FRONTEND_ORIGIN=http://localhost:3000

# Smart Chef (Epic 6). Leaving OPENAI_API_KEY unset means every Smart Chef
# call fails at request time; the app logs a warning at startup if that
# happens, mirroring JWT_SECRET_KEY's own missing-secret warning above.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# On startup, if the users table is empty, the app creates a default Admin
# (username "admin", password "ChangeMe123!" - change it immediately from the
# Users screen). Only ever fires once the table has at least one row (any
# role, active or not); set to false to disable entirely.
BOOTSTRAP_ADMIN=true
